# Production reverse proxy. Rendered by the official nginx image (envsubst on /etc/nginx/templates):
# only variables defined in the container environment (SERVER_NAME) are substituted; nginx's own
# $host, $scheme, ... are left untouched.

# X-Forwarded-For được GHI ĐÈ bằng địa chỉ kết nối thật ($remote_addr), không nối tiếp giá trị trình duyệt gửi:
# trong mạng nội bộ (dải IP riêng được API tin cậy qua TRUST_PROXY), người dùng không tự đặt được IP để vượt giới
# hạn đăng nhập sai hay làm sai IP trong nhật ký. Nếu đặt thêm một bộ cân bằng tải phía trước nginx, đổi lại
# thành $proxy_add_x_forwarded_for và chỉ tin địa chỉ của bộ cân bằng tải đó.

# Giới hạn tốc độ: quá ngưỡng thì xếp hàng (tăng độ trễ) trước, chỉ trả 429 khi vượt cả hàng đợi.
# API tính theo cookie phiên vì nhiều người dùng nội bộ có thể đi chung một IP qua NAT; chưa đăng nhập thì theo IP.
map $cookie_rtms_session $api_limit_key {
    ""      $binary_remote_addr;
    default $cookie_rtms_session;
}
limit_req_zone $api_limit_key       zone=api_per_client:10m rate=20r/s;
limit_req_zone $binary_remote_addr  zone=login_per_ip:10m   rate=60r/m;
limit_req_status 429;

# Log truy cập kèm request_id (cùng mã gửi cho API qua X-Request-Id và trả về trình duyệt), để tra một lỗi
# người dùng báo từ log nginx sang log API. rt = thời gian xử lý (giây), urt = thời gian chờ upstream.
log_format docmans '$remote_addr - $remote_user [$time_local] "$request" $status $body_bytes_sent '
                   '"$http_referer" "$http_user_agent" request_id=$request_id rt=$request_time urt=$upstream_response_time';
access_log /var/log/nginx/access.log docmans;

upstream docmans_api {
    server api:4000;
    keepalive 32;
}

# Chỉ gửi "Connection: upgrade" khi trình duyệt thật sự nâng cấp WebSocket, để giữ được keepalive tới web.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      "";
}

upstream docmans_web {
    server web:3000;
    keepalive 16;
}

server {
    listen 80 default_server;
    server_name ${SERVER_NAME};

    # Healthcheck của container nginx (Docker gọi từ bên trong container), không chuyển sang HTTPS.
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Xác thực tên miền cho Let's Encrypt (service certbot, profile letsencrypt); thư mục rỗng nếu không dùng.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Không lộ phiên bản nginx trong header và trang lỗi.
    server_tokens off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    # Chống clickjacking: không cho trang khác nhúng hệ thống vào iframe.
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    # Chính sách bảo mật nội dung đầy đủ do giao diện Next.js đặt cho từng trang (apps/web/src/proxy.ts, có nonce);
    # dòng trên chỉ là lớp chống nhúng iframe áp cho mọi phản hồi, kể cả API. Hai chính sách cùng áp dụng.
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy same-origin always;
    add_header Cross-Origin-Resource-Policy same-origin always;

    # FILE_MAX_UPLOAD_BYTES defaults to 10 MB; 11m leaves room for multipart overhead.
    # Raise both together (backend remains authoritative).
    client_max_body_size 11m;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types application/json application/javascript text/css text/plain image/svg+xml;

    # Chống dò mật khẩu và mã xác thực hai lớp ở tầng proxy (API còn khoá theo số lần sai). Ngưỡng rộng vì nhiều người có thể chung IP.
    location ~ ^/api/v1/auth/login(/verify|/resend)?$ {
        limit_req zone=login_per_ip burst=30 nodelay;
        proxy_pass http://docmans_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # Mã tra cứu chung giữa log nginx và log API (API trả lại trong header X-Request-Id).
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # NestJS API: controllers already carry the /api/v1 prefix, so the full URI is forwarded unchanged.
    location /api/ {
        limit_req zone=api_per_client burst=60 delay=20;
        proxy_pass http://docmans_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # Mã tra cứu chung giữa log nginx và log API (API trả lại trong header X-Request-Id).
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Next.js web
    location / {
        proxy_pass http://docmans_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
