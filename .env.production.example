# Copy to .env.production (git-ignored) and fill in EVERY value before deploying.
# docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# Public address users open in the browser (no trailing slash). Used by the API for CORS and
# links in account e-mails. The web bundle calls the relative /api/v1, so the image is not tied
# to this domain (override NEXT_PUBLIC_API_BASE_URL only if the API lives on another origin).
PUBLIC_URL=https://docmans.example.vn
SERVER_NAME=docmans.example.vn
APP_VERSION=1.0.0

# Email nhận thông báo của Let's Encrypt (chỉ khi dùng profile letsencrypt, xem scripts/letsencrypt-init.sh).
LETSENCRYPT_EMAIL=

# PostgreSQL
POSTGRES_USER=docmans
POSTGRES_PASSWORD=
POSTGRES_DB=docmans

# MinIO (object storage). Use a long random secret.
MINIO_ROOT_USER=docmans
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_NAME=docmans-files
# Tài khoản riêng cho API, chỉ có quyền trên bucket trên (service minio-init tạo/cập nhật mỗi lần khởi động).
# Phải khác MINIO_ROOT_USER; mật khẩu tối thiểu 8 ký tự, nên dùng chuỗi ngẫu nhiên dài.
MINIO_APP_ACCESS_KEY=docmans-api
MINIO_APP_SECRET_KEY=

# Khoá ký mã chống giả mạo yêu cầu (CSRF): chuỗi ngẫu nhiên ít nhất 32 ký tự (openssl rand -base64 32).
# Đổi khoá chỉ làm người dùng phải tải lại trang, không mất dữ liệu.
CSRF_SECRET=

# Chính sách bảo mật nội dung của giao diện: report-only (mặc định, chỉ báo cáo vi phạm) hoặc enforce (chặn).
# CSP_MODE=report-only

# Xác thực hai lớp qua thư: required-roles (mặc định) hoặc off (chỉ khi máy chủ thư hỏng).
# LOGIN_OTP_MODE=required-roles
# Image MinIO: MinIO đã ngừng phát hành image công khai. Mặc định docmans.local/minio:RELEASE.2025-09-07T16-13-09Z,
# nạp sẵn trên máy chủ bằng: ./scripts/minio-image.sh load minio-RELEASE.2025-09-07T16-13-09Z-amd64.tar.gz
# Hoặc dùng registry nội bộ (sau ./scripts/minio-image.sh push <registry>):
# MINIO_IMAGE=registry.hvqy.edu.vn/docmans/minio:RELEASE.2025-09-07T16-13-09Z

# Số kết nối PostgreSQL tối đa của API (mặc định 15; tổng mọi bản API phải < max_connections = 100).
DB_POOL_MAX=15

# Bootstrap administrator. ADMIN_INITIAL_PASSWORD is needed only for the first deploy (>= 12 chars);
# the admin must change it at first login. Remove it from this file afterwards.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
# Thư công vụ của quản trị: nhận mã xác thực hai lớp khi đăng nhập. Bắt buộc; thiếu thì quản trị không đăng nhập được.
ADMIN_EMAIL=

# Account e-mail (activation / password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Mặc định bắt buộc STARTTLS. Chỉ đặt false nếu máy chủ chuyển tiếp thư nội bộ không hỗ trợ STARTTLS
# (thư kích hoạt bị lỗi "STARTTLS ... not implemented" trong log API); khi đó mật khẩu SMTP đi dạng rõ.
SMTP_REQUIRE_TLS=true
# Nhắc hạn báo cáo hằng ngày (07:00 giờ Việt Nam); chống gửi trùng nên chạy nhiều bản API vẫn an toàn.
DEADLINE_REMINDERS_ENABLED=true
# Ảnh chụp sức khoẻ đề tài hằng tuần (23:55 Chủ nhật giờ Việt Nam); không ghi trùng khi chạy nhiều bản API.
HEALTH_SNAPSHOTS_ENABLED=true

# Log request của API (JSON, kèm request id): errors (mặc định: chỉ lỗi 5xx và request chậm > 1 giây),
# all (mọi request, chỉ bật khi điều tra vì tốn dung lượng), off.
LOG_REQUESTS=errors

# Uploads (keep <= nginx client_max_body_size)
FILE_MAX_UPLOAD_BYTES=10485760
FILE_ALLOWED_EXTENSIONS=.doc,.docx,.pdf,.xls,.xlsx
