+// Cùng định dạng với apps/api/src/auth/password.service.ts: "scrypt:<salt>:<hex 64 byte>".
+function hashPassword(password) {
+  const salt = randomBytes(16).toString("hex");
+  return `scrypt:${salt}:${scryptSync(password, salt, 64).toString("hex")}`;
+}
+
+// Cùng chính sách với apps/api/src/auth/password-request.pipe.ts.
+function assertPasswordPolicy(password) {
+  if (password.length < 12 || password.length > 256 || /\s/.test(password) || !/[a-z]/.test(password) || !/[A-Z]/.test(password) || !/\d/.test(password)) {
